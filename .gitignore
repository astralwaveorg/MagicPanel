node_modules/
dist/
# 文档站点源码（由 scripts/build_docs_site.py 生成）
docs_site/
data/
# 同时覆盖 .venv 目录与 .venv 符号链接（venv 放在仓库外时用链接指过去）
.venv
__pycache__/
*.pyc
.DS_Store
.cache/
server/app/static/
.ref/
*.log
# 家庭网络内部文档，不进仓库
docs/network/

# 历史开发文档与一次性脚本：留在本机与 NAS 归档，不再进仓库
docs/archive/
# 临时目录（抓下来的配置片段等）
tmp/
# pytest 缓存
.pytest_cache/
.workbuddy/

# 文档区默认只提交清单内的文件。新增共享手册前先核对用途及示例。
/docs/**
!/docs/deployment/
!/docs/development/
!/docs/reference/
!/docs/README.md
!/docs/deployment/1Panel-Docker-部署.md
!/docs/development/MagicPanel-开发规格.md
!/docs/development/MagicPanel-构建与发布-产物构成.md
