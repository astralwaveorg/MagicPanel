#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
start_service() {
    [ -f /etc/magicpanel-owner/owner.env ] || return 1
    procd_open_instance
    procd_set_param command /bin/sh /usr/libexec/magicpanel/gateway_watch.sh /etc/magicpanel-owner
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
